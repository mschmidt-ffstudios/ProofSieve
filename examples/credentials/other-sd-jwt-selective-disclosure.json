{
  "id": "other-sd-jwt-selective-disclosure",
  "title": {
    "de": "SD-JWT · selektive Offenlegung",
    "en": "SD-JWT · selective disclosure"
  },
  "source": {
    "label": "IETF RFC 9901 · A.3",
    "url": "https://www.rfc-editor.org/rfc/rfc9901.html#appendix-A.3"
  },
  "format": "SD-JWT+KB",
  "representation": {
    "de": "Verarbeiteter JSON-Payload aus dem publizierten Testvektor. Offengelegt sind Staatsangehörigkeit und die Aussage 18+. Die Beispielregel prüft die angegebene Aussteller-URI.",
    "en": "Processed JSON payload from the published test vector. It discloses nationality and the over-18 claim. The example rule compares the declared issuer URI."
  },
  "input": {
    "iss": "https://pid-issuer.bund.de.example",
    "iat": 1683000000,
    "exp": 1883000000,
    "vct": "urn:eudi:pid:de:1",
    "cnf": {
      "jwk": {
        "kty": "EC",
        "crv": "P-256",
        "x": "TCAER19Zvu3OHF4j4W4vfSVoHIP1ILilDls7vCeGemc",
        "y": "ZxjiWWbZMQGHVWKVQ4hbSIirsVfuecCE6t4jT9F2HZQ"
      }
    },
    "age_equal_or_over": {
      "18": true
    },
    "nationalities": [
      "DE"
    ]
  },
  "check": {
    "field": "iss",
    "expected": "https://pid-issuer.bund.de.example",
    "negative": "https://unlisted-issuer.example"
  }
}
