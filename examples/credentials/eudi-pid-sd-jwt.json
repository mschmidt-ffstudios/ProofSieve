{
  "id": "eudi-pid-sd-jwt",
  "title": {
    "de": "EUDI-Personenidentität (SD-JWT VC)",
    "en": "EUDI person identification data (SD-JWT VC)"
  },
  "source": {
    "label": "EUDI PID Rulebook §4.3",
    "url": "https://github.com/eu-digital-identity-wallet/eudi-doc-attestation-rulebooks-catalog/blob/36f8adcf914ac06cac18d685add04e0a8a06d685/rulebooks/pid/pid-rulebook.md#43-example"
  },
  "format": "SD-JWT VC",
  "representation": {
    "de": "Synthetischer Beispiel-Payload nach dem PID Rulebook vor der SD-JWT-Kodierung. Der Guard prüft hier den Typwert vct im JSON.",
    "en": "Synthetic example payload based on the PID Rulebook before SD-JWT encoding. The Guard checks the vct type value in the JSON."
  },
  "input": {
    "vct": "urn:eudi:pid:de:1",
    "given_name": "Alex",
    "family_name": "Beispiel",
    "birthdate": "1994-02-14",
    "address": {
      "street_address": "Musterweg 4",
      "locality": "Beispielstadt",
      "postal_code": "12345",
      "country": "DE"
    },
    "nationalities": [
      "DE"
    ],
    "issuing_authority": "DE",
    "issuing_country": "DE"
  },
  "check": {
    "field": "vct",
    "expected": "urn:eudi:pid:de:1",
    "negative": "urn:eudi:pid:other:1"
  }
}
