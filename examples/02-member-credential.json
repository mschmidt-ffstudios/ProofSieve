{
  "id": "02-member-credential",
  "title": "Active SD-JWT VC membership from an authorized issuer",
  "appliesTo": {
    "format": "application/dc+sd-jwt",
    "type": "https://proofsieve.example/vocab/MemberCredential",
    "typeIdentifier": "vct"
  },
  "checks": [
    {
      "id": "credential-proof",
      "kind": "credential-verification",
      "fact": "uv:credentialVerified",
      "configuration": {
        "profile": "operator-pinned IETF SD-JWT VC variant",
        "requiredChecks": ["issuer-signature", "issuer-key-binding", "disclosure-digests", "validity-period", "credential-type", "holder-key-binding"],
        "bindHolderProofTo": ["verifier-audience", "request-nonce"]
      }
    },
    {
      "id": "member-issuer",
      "kind": "issuer-authorization",
      "fact": "uv:membershipIssuerAuthorized",
      "configuration": {
        "issuer": "https://membership.proofsieve.example",
        "credentialType": "https://proofsieve.example/vocab/MemberCredential"
      }
    },
    {
      "id": "active-status",
      "kind": "credential-status",
      "fact": "uv:membershipStatusActive",
      "configuration": {
        "method": "IETF Token Status List",
        "acceptedStatus": 0,
        "verifyStatusListProof": true,
        "requireAuthorizedStatusListIssuer": true
      }
    },
    {
      "id": "member-subject",
      "kind": "subject-binding",
      "fact": "uv:memberSubjectBound",
      "configuration": {
        "compareCredentialSubjectTo": "authenticated-principal"
      }
    }
  ],
  "odrl": {
    "@context": ["http://www.w3.org/ns/odrl.jsonld", {"uv": "https://proofsieve.example/vocab/"}],
    "@type": "Set",
    "uid": "https://proofsieve.example/rules/02-member-credential",
    "profile": "https://proofsieve.example/profiles/verification/v1",
    "permission": [{
      "target": "https://proofsieve.example/resources/member-area",
      "action": "uv:approve",
      "constraint": [
        {"leftOperand": "uv:credentialVerified", "operator": "eq", "rightOperand": true},
        {"leftOperand": "uv:membershipIssuerAuthorized", "operator": "eq", "rightOperand": true},
        {"leftOperand": "uv:membershipStatusActive", "operator": "eq", "rightOperand": true},
        {"leftOperand": "uv:memberSubjectBound", "operator": "eq", "rightOperand": true}
      ]
    }]
  },
  "output": {"mode": "boolean"},
  "cases": [
    {
      "id": "allow",
      "facts": {"uv:credentialVerified": true, "uv:membershipIssuerAuthorized": true, "uv:membershipStatusActive": true, "uv:memberSubjectBound": true},
      "expected": {"valid": true, "forwarded": false},
      "reason": "An authorized issuer issued the active credential to the authenticated member."
    },
    {
      "id": "deny-unauthorized-issuer",
      "facts": {"uv:credentialVerified": true, "uv:membershipIssuerAuthorized": false, "uv:membershipStatusActive": true, "uv:memberSubjectBound": true},
      "expected": {"valid": false, "forwarded": false},
      "reason": "The credential verifies, but its issuer cannot issue memberships for this resource."
    },
    {
      "id": "deny-revoked-membership",
      "facts": {"uv:credentialVerified": true, "uv:membershipIssuerAuthorized": true, "uv:membershipStatusActive": false, "uv:memberSubjectBound": true},
      "expected": {"valid": false, "forwarded": false},
      "reason": "The authorized status list marks the membership token invalid."
    },
    {
      "id": "deny-another-members-credential",
      "facts": {"uv:credentialVerified": true, "uv:membershipIssuerAuthorized": true, "uv:membershipStatusActive": true, "uv:memberSubjectBound": false},
      "expected": {"valid": false, "forwarded": false},
      "reason": "The credential names a different subject than the authenticated principal."
    }
  ],
  "sources": [
    "https://www.rfc-editor.org/rfc/rfc9901.html",
    "https://datatracker.ietf.org/doc/draft-ietf-oauth-sd-jwt-vc/",
    "https://datatracker.ietf.org/doc/draft-ietf-oauth-status-list/"
  ]
}
