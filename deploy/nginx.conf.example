# Include in Nginx's http context. Replace the example DNS name and allowed network.
limit_req_zone $binary_remote_addr zone=proofsieve_api:1m rate=10r/s;

upstream proofsieve_api {
    server unix:/run/proofsieve-ingress/api.sock;
}

server {
    listen 443 ssl;
    server_name proofsieve-api.example.test;
    ssl_certificate /etc/proofsieve/tls/fullchain.pem;
    ssl_certificate_key /etc/proofsieve/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    allow 192.0.2.0/24;
    deny all;

    client_max_body_size 96k;
    client_body_buffer_size 96k;
    client_header_timeout 5s;
    client_body_timeout 5s;
    access_log off;
    limit_req_status 429;

    if ($host != proofsieve-api.example.test) { return 421; }

    location ~ ^/(?:openapi\.json|verify(?:/[A-Za-z0-9_-]+)*)$ {
        if ($is_args) { return 400; }
        limit_req zone=proofsieve_api burst=20 nodelay;
        proxy_pass http://proofsieve_api;
        proxy_http_version 1.1;
        proxy_set_header Host proofsieve-api.example.test;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Connection close;
        proxy_set_header Proxy "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_request_buffering on;
        proxy_connect_timeout 2s;
        proxy_send_timeout 5s;
        proxy_read_timeout 22s;
    }

    location / {
        return 404;
    }
}
